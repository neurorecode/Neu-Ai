# ==== Neu AI production configuration (copy to deploy/.env) ====

# Your domain, already pointed (A record) at this server's IP
DOMAIN=neu.neurorecode.in

# Postgres password (generate: openssl rand -hex 16)
POSTGRES_PASSWORD=

# JWT session signing key (generate: openssl rand -hex 32)
SECRET_KEY=

# Google OAuth (console.cloud.google.com -> your project -> Clients)
# Remember to add https://$DOMAIN/api/auth/google/callback as a redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional extra guard: comma-separated email domains allowed to sign in
AUTH_ALLOWED_EMAIL_DOMAINS=

# AI summaries & chat (platform.claude.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Transcription
STT_PROVIDER=sarvam
SARVAM_API_KEY=
LANGUAGE_LLM_FALLBACK=true

# ---- Meeting bot (auto-join Meet/Zoom/Teams via Recall.ai) ----
# Leave BOT_PROVIDER=none to disable. Set to "recall" + key to enable auto-join.
BOT_PROVIDER=none
RECALL_API_KEY=
RECALL_REGION=us-west-2
BOT_NAME=Neu AI Notetaker
# Random string guarding the webhook path (generate: openssl rand -hex 16).
# Configure Recall to call https://$DOMAIN/api/bots/webhook/$WEBHOOK_SECRET
WEBHOOK_SECRET=

# ---- Email recap (SMTP; leave SMTP_HOST empty to log recaps instead) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Neu AI <noreply@neurorecode.in>
SMTP_STARTTLS=true

# ---- Audio retention (disk hygiene) ----
# Delete original recordings older than N days; transcript + summary are kept
# forever. 0 = keep recordings forever (default). For heavy daily use, 30 is a
# sensible value to stop the disk filling up.
AUDIO_RETENTION_DAYS=0
