# ---- LLM (summaries, action items, meeting chat) ----
# Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
# Model used for summarization and chat
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Speech-to-text provider ----
# One of: mock | sarvam | openai | local
#   mock   - no keys needed; returns a demo Tanglish transcript (for trying the app)
#   sarvam - Sarvam AI "saarika" model. Best accuracy for Tamil & Tanglish (code-mixed).
#            Get a key at https://www.sarvam.ai
#   openai - OpenAI Whisper API (whisper-1). Good for English & Tamil.
#   local  - faster-whisper running locally (pip install faster-whisper). No API key.
STT_PROVIDER=mock
SARVAM_API_KEY=
OPENAI_API_KEY=
# Model size for local faster-whisper: tiny | base | small | medium | large-v3
LOCAL_WHISPER_MODEL=small

# ---- Speaker diarization (optional) ----
# none | pyannote. pyannote requires: pip install pyannote.audio, plus a
# Hugging Face token with access to pyannote/speaker-diarization-3.1
DIARIZATION=none
HF_TOKEN=

# ---- Language detection ----
# When true and an Anthropic key is set, ambiguous segments are re-checked by Claude
LANGUAGE_LLM_FALLBACK=true

# ---- Meeting bot (auto-join Meet/Zoom/Teams) ----
# none | recall (Recall.ai). Leave 'none' for local dev.
BOT_PROVIDER=none
RECALL_API_KEY=
RECALL_REGION=us-west-2
BOT_NAME=Neu AI Notetaker
WEBHOOK_SECRET=changeme-webhook-secret

# ---- Email recap (SMTP) ----
# Leave SMTP_HOST empty to log recaps to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Neu AI <noreply@localhost>
SMTP_STARTTLS=true

# ---- Storage ----
# SQLite for development; Postgres in production (see deploy/docker-compose.yml)
DATABASE_URL=sqlite:///./data/neu.db
UPLOAD_DIR=./data/uploads

# ---- Auth (Google sign-in) ----
# Leave GOOGLE_CLIENT_ID empty for single-user dev mode (auto-login as dev@localhost).
# Create credentials at console.cloud.google.com -> your project -> Clients,
# with redirect URI: {BACKEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
SECRET_KEY=
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Optional: comma-separated email domains allowed to sign in
AUTH_ALLOWED_EMAIL_DOMAINS=
